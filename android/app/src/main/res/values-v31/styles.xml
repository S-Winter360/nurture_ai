<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/nurture_teal</item>
        <!-- Android 12+ specific splash screen attributes -->
        <item name="android:windowSplashScreenBackground">@color/nurture_teal</item>
        <!-- This hides the default Flutter icon by replacing it with our solid teal background -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_background</item>
    </style>
    
    <!-- Theme applied to the Android Window as soon as the process has started -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>