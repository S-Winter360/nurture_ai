# NurtureAI Environment Configuration Example
# Never commit real credentials or production secrets here.

# Remote secure clinical AI gateway endpoint for CloudAiProvider
# Example: https://api.ghs-clinical-ai.gov.gh or /api/ai/chat
# The client sends requests to POST {VITE_AI_API_BASE_URL}/api/ai/chat or /v1/ai/chat
# When left empty, Cloud AI is safely disabled and deterministic offline fallback is used.
VITE_AI_API_BASE_URL=

# Timeout in milliseconds for Cloud AI requests (default: 10000, minimum floor: 2000)
VITE_AI_TIMEOUT_MS=10000

# BACKEND ONLY (Server-side secret, NEVER prefix with VITE_):
# Used exclusively by the server-side AI Gateway to invoke Google Gemini.
GEMINI_API_KEY=

# SECURITY NOTE:
# Do not place provider API keys, Gemini keys, OpenAI keys, bearer tokens, or private
# credentials in VITE_* environment variables. All provider secrets MUST reside strictly
# server-side within the secure backend gateway.
